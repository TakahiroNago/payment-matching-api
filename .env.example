# Copy to .env (ignored by git). Used by `docker compose`, by `cargo run` and by sqlx's compile-time checks.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/payment_matching
# At least 16 characters. Generate one with: openssl rand -hex 24
API_TOKEN=
BIND_ADDR=127.0.0.1:8080
# Transfer fees (yen) tried by rule R3, comma separated.
# FEE_AMOUNTS=110,220,330,440,550,660,770,880
